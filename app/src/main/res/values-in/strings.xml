    <string name="background_guide_xiaomi">Di MIUI/HyperOS buka Keamanan → Autostart, aktifkan Pocket Share, lalu pilih Baterai → Tanpa batasan.</string>
    <string name="background_guide_huawei">Buka Pengelola Telepon → Peluncuran aplikasi, matikan pengelolaan otomatis untuk Pocket Share, lalu izinkan aktivitas latar belakang.</string>
    <string name="background_guide_honor">Buka Honor Manager → Peluncuran aplikasi, matikan pengelolaan otomatis untuk Pocket Share, lalu izinkan aktivitas latar belakang.</string>
    <string name="background_guide_coloros">Buka Baterai → Optimasi baterai → Pocket Share → Jangan optimalkan. Aktifkan juga Izinkan aktivitas latar belakang dan Auto-start.</string>
    <string name="background_guide_vivo">Buka iManager → Pengelolaan aplikasi → Autostart, aktifkan Pocket Share, lalu izinkan latar belakang daya tinggi.</string>
    <string name="background_guide_samsung">Buka Perawatan perangkat → Baterai → Batas penggunaan latar belakang, lalu tambahkan Pocket Share ke aplikasi yang tidak pernah tidur.</string>
    <string name="background_guide_asus">Buka Mobile Manager → PowerMaster → Auto-start Manager, izinkan Pocket Share berjalan di latar belakang.</string>
    <string name="background_guide_transsion">Buka Phone Master → Autostart, izinkan Pocket Share, lalu aktifkan Power Marathon untuk aktivitas latar belakang.</string>
    <string name="background_guide_nokia">Buka Power Saver → Exception list, lalu tambahkan Pocket Share.</string>
    <string name="background_guide_meizu">Buka Keamanan → Izin → Autostart, lalu izinkan Pocket Share.</string>
    <string name="background_guide_letv">Buka Letv Safe → Autoboot, lalu izinkan Pocket Share.</string>
    <string name="background_guide_lenovo">Buka Keamanan → Pengelolaan aplikasi latar belakang, lalu izinkan Pocket Share.</string>
    <string name="background_guide_generic">Buka Info aplikasi → Baterai → Jangan optimalkan/Tanpa batasan. Jika perangkat punya pengelola autostart, izinkan Pocket Share di sana juga.</string>
